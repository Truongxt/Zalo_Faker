# Supabase configuration (optional if your app still uses it)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend endpoints for web app
# Production example:
# VITE_API_URL=http://13.212.107.150/api
# VITE_SOCKET_URL=http://13.212.107.150
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# WebRTC across different networks usually needs TURN, not only STUN.
# VITE_TURN_URL can be a comma-separated list. A plain turn:host:3478 value
# is expanded in code to UDP and TCP transport variants.
VITE_TURN_URL=turn:your-turn-host:3478
VITE_TURNS_URL=turns:your-turn-host:5349?transport=tcp
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-password
# Set to "relay" temporarily to verify that TURN relay works end-to-end.
VITE_ICE_TRANSPORT_POLICY=all
