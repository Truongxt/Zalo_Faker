# EXPO_PUBLIC_API_URL is intentionally unset so the platform-aware default in
# constants/config.ts takes effect (10.0.2.2 on Android, localhost on web).
# Override only when targeting a specific server, e.g.:
# EXPO_PUBLIC_API_URL=http://172.20.10.2:3000
# VITE_BACKEND_URL=http://172.20.10.2:3000

EXPO_PUBLIC_API_URL=http://192.168.0.109:3000
VITE_BACKEND_URL=http://192.168.0.109:3000

# EXPO_PUBLIC_API_URL=http://192.168.0.108:3000
# VITE_BACKEND_URL=http://192.168.0.108:3000

# EXPO_PUBLIC_API_URL=http://172.27.144.1:3000
# VITE_BACKEND_URL=http://172.27.144.1:3000

# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# VITE_BACKEND_URL=http://10.0.2.2:3000

#  EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#   EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3000

#  VITE_BACKEND_URL=http://10.0.2.2:3000

#  EXPO_PUBLIC_API_URL=http://localhost:3000
#  VITE_BACKEND_URL=http://localhost:3000

EXPO_PUBLIC_API_URL=https://taklo.duckdns.org
EXPO_PUBLIC_SOCKET_URL=https://taklo.duckdns.org
VITE_BACKEND_URL=https://taklo.duckdns.org

# TURN cho WebRTC
EXPO_PUBLIC_TURN_URL=turn:13.212.107.150:3478
EXPO_PUBLIC_TURN_USERNAME=webrtc
EXPO_PUBLIC_TURN_CREDENTIAL=123456
