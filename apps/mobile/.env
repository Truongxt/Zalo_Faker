# EXPO_PUBLIC_API_URL is intentionally unset so the platform-aware default in
# constants/config.ts takes effect (10.0.2.2 on Android, localhost on web).
# Override only when targeting a specific server, e.g.:



# EXPO_PUBLIC_API_URL=http://172.20.10.2:3000
# VITE_BACKEND_URL=http://172.20.10.2:3000



EXPO_PUBLIC_API_URL=http://192.168.1.12:3000
VITE_BACKEND_URL=http://192.168.1.12:3000
# VITE_BACKEND_URL=http://192.168.0.108:3000

# EXPO_PUBLIC_API_URL=http://192.168.2.168:3000
# VITE_BACKEND_URL=http://192.168.2.168:3000


#  EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#  VITE_BACKEND_URL=http://10.0.2.2:3000
