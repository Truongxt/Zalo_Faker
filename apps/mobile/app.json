{
  "expo": {
    "name": "taklo",
    "slug": "taklo",
    "scheme": "taklo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icon.png",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0068FF"
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép taklo truy cập ảnh của bạn",
          "cameraPermission": "Cho phép taklo sử dụng camera"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.taklo.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cho phep taklo su dung microphone de goi thoai",
        "NSCameraUsageDescription": "Cho phep taklo su dung camera de goi video",
        "NSContactsUsageDescription": "Cho phep taklo truy cap danh ba de goi y ket ban"
      }
    },
    "android": {
      "package": "com.taklo.app",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0068FF"
      }
    }
  }
}
