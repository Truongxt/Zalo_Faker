{
  "expo": {
    "name": "Zalo Faker",
    "slug": "zalo-faker",
    "scheme": "zalofaker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icon.png",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0068FF"
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Zalo Faker truy cập ảnh của bạn",
          "cameraPermission": "Cho phép Zalo Faker sử dụng camera"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.zalofaker.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.zalofaker.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0068FF"
      }
    }
  }
}
